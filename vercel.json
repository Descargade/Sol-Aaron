{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install -g pnpm && pnpm install",
  "buildCommand": "pnpm --filter @workspace/nuestra-historia run build",
  "outputDirectory": "artifacts/nuestra-historia/dist/public",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://nuestra-historia-api-wub1.onrender.com/api/$1" },
    { "source": "/((?!assets/|.*\\.).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
