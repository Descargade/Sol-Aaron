# =============================================================================
# NUESTRA HISTORIA — Variables de entorno
# =============================================================================
# Copiá este archivo como .env y completá los valores.
# NUNCA subas .env al repositorio.

# =============================================================================
# BACKEND (API Server — Replit u otro hosting)
# =============================================================================

# --- Base de datos ---
# URL de conexión a PostgreSQL (requerida)
DATABASE_URL=postgresql://usuario:password@localhost:5432/nuestra_historia

# --- Autenticación ---
# Contraseñas de los administradores (requeridas).
# Se usan para crear/verificar las cuentas de admin al iniciar el servidor.
# Se almacenan con hashing scrypt, nunca se exponen en el frontend.
SOL_ADMIN_PASSWORD=
AARON_ADMIN_PASSWORD=

# --- Servidor ---
# Puerto del API server (requerido en Replit)
PORT=5000

# --- Almacenamiento (Google Cloud Storage) ---
# Directorio privado en el bucket para archivos subidos (requerido)
# Ejemplo: /mi-bucket/nuestra-historia
PRIVATE_OBJECT_DIR=

# --- Entorno ---
# "development" o "production" (afecta cookies seguras, logs, etc.)
NODE_ENV=development

# --- Logging (opcional) ---
# Nivel de log de pino. Default: "info"
# Opciones: trace, debug, info, warn, error, fatal
# LOG_LEVEL=info

# =============================================================================
# FRONTEND (Vercel)
# =============================================================================

# --- URL del API Backend ---
# URL completa del API server donde está desplegado el backend.
# Ejemplo: https://nuestra-historia-api.vercel.app  o  https://tu-repl.repl.co
# Si se deja vacío, el frontend asume que la API está en el mismo dominio (/api).
VITE_API_URL=

# --- Path base de Vite ---
# Path base para el build de Vite. Default: "/"
BASE_PATH=/
